# Copy to .env (gitignored) and fill in real values. Never commit the real .env.

# A long random secret shared only by this relay and the Firebase Cloud Function that issues
# short-lived, session-scoped JWTs. Generate one with: openssl rand -hex 32
RELAY_JWT_SECRET=

# From the Cloudflare Zero Trust dashboard: Networks -> Tunnels -> Create a tunnel -> Docker.
# Cloudflare shows a `docker run ... --token eyJ...` command; copy just the token value here.
CLOUDFLARE_TUNNEL_TOKEN=
